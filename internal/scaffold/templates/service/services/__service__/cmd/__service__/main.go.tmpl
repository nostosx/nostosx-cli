package main

import (
	"context"
	"errors"
	"flag"
	"os"

	"github.com/nostosx/servex/app"

	"[[.Module]]/infrastructure/config"
 "[[.Module]]/infrastructure/logging"
	service "[[.Module]]/services/[[.Service]]"
)

func main() {
	if err := run(); err != nil {
		logging.Report(err)
		os.Exit(1)
	}
}

func run() error {
	cfg, err := config.Load(context.Background(), "[[.Service]]", "services/[[.Service]]/config/config.toml", os.Args[1:], os.Stderr)
	if errors.Is(err, flag.ErrHelp) { return nil }
	if err != nil { return err }
	ctx, stop := app.SignalContext(context.Background())
	defer stop()
	return service.Run(ctx, cfg)
}
