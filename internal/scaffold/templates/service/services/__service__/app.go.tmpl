// Package [[.Service]] is the composition root of the [[.Service]] service.
package [[.Service]]

import (
 "context"
 "errors"
 "time"

 "github.com/nostosx/servex/app"
 "github.com/nostosx/servex/health"
 [[if .HTTP]]"github.com/nostosx/servex-contrib/transport/httpx"[[end]]
 [[if .GRPC]]"google.golang.org/grpc"[[end]]

 "[[.Module]]/infrastructure/config"
 "[[.Module]]/infrastructure/logging"
 "[[.Module]]/infrastructure/server"
 serviceapp "[[.Module]]/services/[[.Service]]/internal/application"
[[if .MySQL]]mysqlinfra "[[.Module]]/infrastructure/database/mysql"[[end]]
[[if .Postgres]]postgresinfra "[[.Module]]/infrastructure/database/postgres"[[end]]
[[if .Kafka]]kafkainfra "[[.Module]]/infrastructure/messaging/kafka"[[end]]
[[if .NATS]]natsinfra "[[.Module]]/infrastructure/messaging/nats"[[end]]

 [[if .HTTP]]httpport "[[.Module]]/services/[[.Service]]/internal/port/http"[[end]]
 [[if .GRPC]]
 pb "[[.Module]]/api/gen/go/[[.Service]]/v1"
 rpcport "[[.Module]]/services/[[.Service]]/internal/port/rpc"[[end]]
)

// Run assembles this service and owns its transport lifecycle.
func Run(ctx context.Context, cfg config.Config) (err error) {
 if err := ctx.Err(); err != nil { return err }
 log, closeLog, err := logging.New(cfg.LogLevel, nil, cfg.LogFile)
 if err != nil { return err }
 defer func() { err = errors.Join(err, closeLog()) }()
 [[if .MySQL]]
 mysqlResource, err := mysqlinfra.New(ctx, cfg.Values)
 if err != nil { return err }
 defer func() { err = errors.Join(err, mysqlResource.Stop(context.WithoutCancel(ctx))) }()
[[end]]
[[if .Postgres]]
 postgresResource, err := postgresinfra.New(ctx, cfg.Values)
 if err != nil { return err }
 defer func() { err = errors.Join(err, postgresResource.Stop(context.WithoutCancel(ctx))) }()
[[end]]
[[if .Kafka]]
 kafkaResource, err := kafkainfra.New(ctx, cfg.Values)
 if err != nil { return err }
 defer func() { err = errors.Join(err, kafkaResource.Stop(context.WithoutCancel(ctx))) }()
[[end]]
[[if .NATS]]
 natsResource, err := natsinfra.New(ctx, cfg.Values)
 if err != nil { return err }
 defer func() { err = errors.Join(err, natsResource.Stop(context.WithoutCancel(ctx))) }()
[[end]]

 var application *app.App
 check := health.CheckerFunc(func(ctx context.Context) error { return application.Check(ctx) })
 servers, err := server.New(ctx, cfg, check, log)
 if err != nil { return err }
 Register([[if .HTTP]]servers.HTTP[[end]][[if and .HTTP .GRPC]], [[end]][[if .GRPC]]servers.GRPC[[end]])
 application = app.New(app.WithLogger(log), app.WithHooks([[if .MySQL]]mysqlResource, [[end]][[if .Postgres]]postgresResource, [[end]][[if .Kafka]]kafkaResource, [[end]][[if .NATS]]natsResource, [[end]][[if .HTTP]]servers.HTTP[[end]][[if and .HTTP .GRPC]], [[end]][[if .GRPC]]servers.GRPC[[end]]), app.WithStopTimeout(10*time.Second))
 return application.Run(ctx)
}

// Register mounts transport handlers. Construct fallible dependencies before calling it.
func Register([[if .HTTP]]http *httpx.Server[[end]][[if and .HTTP .GRPC]], [[end]][[if .GRPC]]registrar grpc.ServiceRegistrar[[end]]) {
 commands := serviceapp.NewCommand(serviceapp.CommandDeps{})
 queries := serviceapp.NewQuery(serviceapp.QueryDeps{})
 [[if .HTTP]]httpport.Register(http, httpport.New[[.ServiceType]]Server(commands,queries))[[end]]
 [[if .GRPC]]pb.Register[[.ServiceType]]ServiceServer(registrar, rpcport.New[[.ServiceType]]Server(commands,queries))[[end]]
}
