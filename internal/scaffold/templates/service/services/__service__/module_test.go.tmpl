package [[.Service]]

import (
	"testing"

	"github.com/nostosx/servex/transport/httpx"
	"google.golang.org/grpc"
)

type registry struct {
	description    *grpc.ServiceDesc
	implementation any
}

func (r *registry) RegisterService(description *grpc.ServiceDesc, implementation any) {
	r.description = description
	r.implementation = implementation
}

func TestRegister(t *testing.T) {
	var registrar registry
	if err := Register(t.Context(), httpx.NewServer(), &registrar); err != nil {
		t.Fatal(err)
	}
	if registrar.description == nil || registrar.description.ServiceName != "[[.Service]].v1.[[.ServiceType]]Service" || registrar.implementation == nil {
		t.Fatalf("service not registered: %+v", registrar)
	}
}
