 "context"

 "github.com/nostosx/servex/errorx"
 "github.com/nostosx/servex-contrib/transport/httpx"
)

type [[.API.RPC]]Request struct {[[range .API.Fields]]
 [[.GoName]] string `json:"[[.Name]]"`[[end]]
}
type [[.API.RPC]]Response struct{}

// [[.API.RPC]] is the HTTP boundary. Implement authorization and the application call here.
func (*Handler) [[.API.RPC]](context.Context, *[[.API.RPC]]Request) (*[[.API.RPC]]Response, error) {
 return nil, errorx.New(errorx.Unimplemented, "NOT_IMPLEMENTED", "operation is not implemented")
}

// Register[[.API.RPC]] mounts this operation. Call it explicitly after configuring authorization.
func Register[[.API.RPC]](server *httpx.Server, handler *Handler) {
