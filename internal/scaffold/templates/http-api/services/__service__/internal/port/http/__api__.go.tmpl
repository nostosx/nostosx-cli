package http

import (
 "context"

 "github.com/nostosx/servex-contrib/transport/httpx"

)

type [[.API.RPC]]Request struct {[[range .API.Fields]]
 [[.GoName]] string `json:"[[.Name]]"`[[end]]
}
type [[.API.RPC]]Response struct{}

// [[.API.RPC]] translates the protocol and invokes the injected application handler.
func (s *[[.ServiceType]]Server) [[.API.RPC]](ctx context.Context, request *[[.API.RPC]]Request) (*[[.API.RPC]]Response, error) {
 result, err := s.[[if eq .API.Kind "command"]]commands[[else]]queries[[end]].[[.API.Field]].Handle(ctx, map[[.API.RPC]]Request(request))
 if err != nil { return nil, err }
 return map[[.API.RPC]]Response(result), nil
}

// Register[[.API.RPC]] mounts this operation. Configure authorization in service assembly.
func Register[[.API.RPC]](server *httpx.Server, handler *[[.ServiceType]]Server) {
 httpx.RouteFunc(server, "[[.API.Method]] [[.API.Path]]", handler.[[.API.RPC]])
}
