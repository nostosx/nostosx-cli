// Package application assembles the monolith host.
package application

import (
 "context"
 "time"

 "github.com/nostosx/servex/app"
 "github.com/nostosx/servex/health"

 "[[.Module]]/infrastructure/config"
 "[[.Module]]/infrastructure/server"
)

// Run constructs dependencies, mounts services and owns the host lifecycle.
func Run(ctx context.Context, cfg config.Config) error {
	var application *app.App
	check := health.CheckerFunc(func(ctx context.Context) error { return application.Check(ctx) })
	servers, err := server.New(ctx, cfg, check)
	if err != nil { return err }
	// Mount added services explicitly here before starting the listeners.
	application = app.New(app.WithHooks([[if .HTTP]]servers.HTTP[[end]][[if and .HTTP .GRPC]], [[end]][[if .GRPC]]servers.GRPC[[end]]), app.WithStopTimeout(10*time.Second))
	return application.Run(ctx)
}
