# Each repository owns this file; no sibling checkout or shared include is required.
version: '3'

vars:
  GO: '{{.GO | default "go"}}'
  GOFMT: '{{.GOFMT | default "gofmt"}}'
  GOLANGCI_LINT: '{{.GOLANGCI_LINT | default "golangci-lint"}}'
  GOVULNCHECK: '{{.GOVULNCHECK | default "govulncheck"}}'
[[if .GRPC]]  NOSTOSX_VERSION: '{{.NOSTOSX_VERSION | default "v1.3.0"}}'[[end]]

tasks:
  fmt:
    desc: Apply Go formatting
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          {{.GOFMT | shellQuote}} -w .

  fmt-check:
    internal: true
    desc: Reject unformatted Go files
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          out=$({{.GOFMT | shellQuote}} -l .); if [ -n "$out" ]; then printf 'gofmt needed:\n%s\n' "$out"; exit 1; fi

  fix:
    desc: Apply Go modernizers in normal and integration builds
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          for tags in '' integration; do {{.GO | shellQuote}} fix -tags "$tags" ./...; done

  modernize-check:
    internal: true
    desc: Reject Go modernizer changes in both builds
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          for tags in '' integration; do out=$({{.GO | shellQuote}} fix -tags "$tags" -diff ./...); if [ -n "$out" ]; then printf '%s\n' "$out"; exit 1; fi; done

  tidy:
    desc: Apply module dependency changes
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          {{.GO | shellQuote}} mod tidy

  tidy-check:
    internal: true
    desc: Reject module dependency changes
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          out=$({{.GO | shellQuote}} mod tidy -diff); if [ -n "$out" ]; then printf '%s\n' "$out"; exit 1; fi

  vet:
    internal: true
    desc: Vet normal and integration builds
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          for tags in '' integration; do {{.GO | shellQuote}} vet -tags "$tags" ./...; done

  build:
    desc: Build normal and integration configurations
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          for tags in '' integration; do {{.GO | shellQuote}} build -tags "$tags" ./...; done

  test:
    desc: Run tests (RACE=true, COVER=true, INTEGRATION=true)
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          race={{.RACE | default "false" | shellQuote}}
          cover={{.COVER | default "false" | shellQuote}}
          integration={{.INTEGRATION | default "false" | shellQuote}}
          for value in "$race" "$cover" "$integration"; do
            case "$value" in true|false) ;; *) echo 'RACE, COVER and INTEGRATION must be true or false'; exit 1 ;; esac
          done
          set -- -shuffle=on -count=1
          if [ "$race" = true ] || [ "$cover" = true ]; then set -- "$@" -race; fi
          if [ "$cover" = true ]; then set -- "$@" -coverprofile=coverage.out -covermode=atomic; fi
          if [ "$integration" = true ]; then set -- "$@" -tags integration; fi
          {{.GO | shellQuote}} test "$@" ./...
          if [ "$cover" = true ]; then {{.GO | shellQuote}} tool cover -func=coverage.out; fi

  lint:
    desc: Lint both builds with golangci-lint v2.15.0
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          for tags in '' integration; do {{.GOLANGCI_LINT | shellQuote}} run --config={{printf "%s/.golangci.yml" .ROOT_DIR | shellQuote}} --build-tags="$tags" ./...; done

  vulncheck:
    desc: Scan both builds with govulncheck v1.9.0
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          for tags in '' integration; do {{.GOVULNCHECK | shellQuote}} -tags "$tags" ./...; done

  check:
    aliases: [default]
    desc: Check formatting, modernization, dependencies, builds and race tests
    cmds:
      - task: fmt-check
      - task: modernize-check
      - task: tidy-check
      - task: vet
      - task: build
      - task: test
        vars:
          RACE: 'true'
          COVER: '{{.COVER | default "false"}}'
          INTEGRATION: '{{.INTEGRATION | default "false"}}'
[[if .GRPC]]
  api:
    desc: Manage Proto contracts (ACTION=generate|lint|check|breaking, default check)
    vars:
      ACTION: '{{.ACTION | default "check"}}'
    preconditions:
      - sh: |
          case {{.ACTION | shellQuote}} in generate|lint|check|breaking) ;; *) exit 1 ;; esac
        msg: 'ACTION must be generate, lint, check or breaking.'
    cmds:
      - |
          set -eu
          export GOWORK=off GO={{.GO | shellQuote}}
          action={{.ACTION | shellQuote}}
          if [ "$action" = breaking ]; then
            test -n {{.API_BASE | default "" | shellQuote}} || { echo 'Set API_BASE to an explicit Git revision'; exit 1; }
          fi
          {{if .NOSTOSX}}
          set -- {{.NOSTOSX | shellQuote}} api
          {{else}}
          set -- {{.GO | shellQuote}} run {{printf "github.com/nostosx/nostosx-cli/cmd/nostosx@%s" .NOSTOSX_VERSION | shellQuote}} api
          {{end}}
          if [ "$action" = check ]; then "$@" lint --dir .; fi
          if [ "$action" = breaking ]; then
            "$@" breaking --dir . --against {{printf ".git#ref=%s" (.API_BASE | default "") | shellQuote}}
          else
            "$@" "$action" --dir .
          fi
[[end -]]
