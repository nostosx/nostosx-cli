func TestValidateRejectsUnsafeConfiguration(t *testing.T) {
 for _, tc := range []struct { name string; edit func(*Config) }{
  [[if .NeedsToken]]{"short token", func(c *Config) { c.Token = "short" }},
  {"whitespace token", func(c *Config) { c.Token = strings.Repeat(" ", 32) }},[[end]]
  [[if .HTTP]]{"public HTTP", func(c *Config) { c.Address = "0.0.0.0:8080" }},[[end]]
  [[if .GRPC]]{"public RPC", func(c *Config) { c.GRPCAddress = ":9090" }},[[end]]
 } {
  t.Run(tc.name, func(t *testing.T) {
   cfg := Config{[[if .HTTP]]Address: "127.0.0.1:0",[[end]][[if .GRPC]]GRPCAddress: "127.0.0.1:0",[[end]][[if .NeedsToken]]Token: strings.Repeat("a", 32),[[end]]}
   tc.edit(&cfg)
   if err := cfg.Validate(); err == nil { t.Fatal("unsafe settings accepted") }
  })
 }
}

func TestLoadRejectsArguments(t *testing.T) {
 for _, arg := range []string{"--bad", "unexpected"[[if not .GRPC]], "--grpc-addr"[[end]][[if not .HTTP]], "--addr"[[end]]} {
  t.Run(arg, func(t *testing.T) {
   if _, err := Load(context.Background(), "test", "config/config.toml", []string{arg}, io.Discard); err == nil { t.Fatal("invalid argument accepted") }
  })
 }
 if _, err := Load(context.Background(), "test", "config/config.toml", []string{"--help"}, io.Discard); !errors.Is(err, flag.ErrHelp) { t.Fatal(err) }
}

func TestLoadDefaults(t *testing.T) {
 clearConfigEnv(t)
 t.Chdir(t.TempDir())
 [[if .NeedsToken]]t.Setenv("API_TOKEN", strings.Repeat("a", 32))[[end]]
 cfg, err := Load(context.Background(), "test", "config/config.toml", nil, io.Discard)
 if err != nil { t.Fatal(err) }
 [[if .HTTP]]if cfg.Address != "127.0.0.1:8080" { t.Fatal(cfg) }[[end]]
 [[if .GRPC]]if cfg.GRPCAddress != "127.0.0.1:9090" { t.Fatal(cfg) }[[end]]
 if cfg.LogFile != "" || cfg.LogLevel != "info" { t.Fatal(cfg) }
 if err := cfg.Validate(); err != nil { t.Fatal(err) }
}


func clearConfigEnv(t *testing.T) {
 t.Helper()
 for _, key := range []string{"APP_ADDRESS", "APP_GRPC_ADDRESS", "APP_LOG_LEVEL", "APP_LOG_FILE", "APP_TOKEN", "API_TOKEN"} {
  t.Setenv(key, "")
  if err := os.Unsetenv(key); err != nil { t.Fatal(err) }
 }
}

func TestLoadProcessFiles(t *testing.T) {
 clearConfigEnv(t)
 t.Chdir(t.TempDir())
 [[if .NeedsToken]]t.Setenv("API_TOKEN", strings.Repeat("a", 32))[[end]]
 paths := []string{"config/config.toml", "services/order/config/config.toml", "services/payment/config/config.toml"}
 levels := []string{"warn", "debug", "error"}
 for i, path := range paths {
  if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil { t.Fatal(err) }
  if err := os.WriteFile(path, []byte("log_level = \""+levels[i]+"\"\n"), 0o600); err != nil { t.Fatal(err) }
 }
 for i, path := range paths {
  cfg, err := Load(t.Context(), "test", path, nil, io.Discard)
  if err != nil { t.Fatal(err) }
  if cfg.LogLevel != levels[i] { t.Fatal("process loaded another configuration", cfg) }
 }
 cfg, err := Load(t.Context(), "test", paths[1], []string{"--config", paths[2]}, io.Discard)
 if err != nil || cfg.LogLevel != "error" { t.Fatal(cfg, err) }
 if err := os.Remove(paths[1]); err != nil { t.Fatal(err) }
 cfg, err = Load(t.Context(), "test", paths[1], nil, io.Discard)
 if err != nil || cfg.LogLevel != "info" { t.Fatal("missing service file must not load root settings", cfg, err) }
}

func TestLoadGeneratedFiles(t *testing.T) {
 clearConfigEnv(t)
 [[if .NeedsToken]]t.Setenv("API_TOKEN", strings.Repeat("a", 32))[[end]]
 t.Chdir(filepath.Join("..", ".."))
 for _, pattern := range []string{"config/config.toml", "services/*/config/config.toml"} {
  paths, err := filepath.Glob(pattern)
  if err != nil { t.Fatal(err) }
  for _, path := range paths {
   if _, err := Load(t.Context(), "test", path, []string{"--config", path}, io.Discard); err != nil { t.Fatalf("load generated %s: %v", path, err) }
  }
 }
}

func TestLoadPrecedence(t *testing.T) {
 clearConfigEnv(t)
 path := filepath.Join(t.TempDir(), "settings.toml")
 content := "[[if .HTTP]]address = \"127.0.0.1:8101\"\n[[end]][[if .GRPC]]grpc_address = \"127.0.0.1:9101\"\n[[end]]log_level = \"warn\"\n[[if .NeedsToken]]token = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n[[end]]"
 if err := os.WriteFile(path, []byte(content), 0o600); err != nil { t.Fatal(err) }
 load := func(args ...string) Config {
  t.Helper()
  cfg, err := Load(t.Context(), "test", "config/config.toml", append([]string{"--config", path}, args...), io.Discard)
  if err != nil { t.Fatal(err) }
  return cfg
 }
 cfg := load()
 if cfg.LogLevel != "warn"[[if .HTTP]] || cfg.Address != "127.0.0.1:8101"[[end]][[if .GRPC]] || cfg.GRPCAddress != "127.0.0.1:9101"[[end]] { t.Fatal(cfg) }
 [[if .NeedsToken]]t.Setenv("API_TOKEN", strings.Repeat("b", 32))
 if cfg := load(); cfg.Token != strings.Repeat("b", 32) { t.Fatal("legacy token did not override file") }
 t.Setenv("APP_TOKEN", strings.Repeat("c", 32))
 if cfg := load(); cfg.Token != strings.Repeat("c", 32) { t.Fatal("APP_TOKEN did not override API_TOKEN") }[[end]]
 [[if .HTTP]]t.Setenv("APP_ADDRESS", "127.0.0.1:8102")[[end]]
 [[if .GRPC]]t.Setenv("APP_GRPC_ADDRESS", "127.0.0.1:9102")[[end]]
 t.Setenv("APP_LOG_LEVEL", "debug")
 t.Setenv("APP_LOG_FILE", "from-env.log")
 cfg = load()
 if cfg.LogFile != "from-env.log" || cfg.LogLevel != "debug"[[if .HTTP]] || cfg.Address != "127.0.0.1:8102"[[end]][[if .GRPC]] || cfg.GRPCAddress != "127.0.0.1:9102"[[end]] { t.Fatal(cfg) }
 // An explicitly supplied default must still override a different environment value.
 cfg = load("--log-file", "", "--log-level", "info"[[if .HTTP]], "--addr", "127.0.0.1:8080"[[end]][[if .GRPC]], "--grpc-addr", "127.0.0.1:9090"[[end]])
 if cfg.LogFile != "" || cfg.LogLevel != "info"[[if .HTTP]] || cfg.Address != "127.0.0.1:8080"[[end]][[if .GRPC]] || cfg.GRPCAddress != "127.0.0.1:9090"[[end]] { t.Fatal(cfg) }
 [[if .NeedsToken]]t.Setenv("APP_TOKEN", "")
 if _, err := Load(t.Context(), "test", "config/config.toml", []string{"--config", path}, io.Discard); err == nil { t.Fatal("explicit empty token accepted") }[[end]]
}

func TestLoadRejectsInvalidSources(t *testing.T) {
 clearConfigEnv(t)
 [[if .NeedsToken]]t.Setenv("API_TOKEN", strings.Repeat("a", 32))[[end]]
 dir := t.TempDir()
 path := filepath.Join(dir, "broken.toml")
 if err := os.WriteFile(path, []byte("log_level = [unterminated"), 0o600); err != nil { t.Fatal(err) }
 for _, tc := range []struct { name string; args []string }{
  {"missing file", []string{"--config", filepath.Join(dir, "missing.toml")}},
  {"malformed file", []string{"--config", path}},
  {"empty path", []string{"--config", ""}},
  {"invalid level", []string{"--log-level", "invalid"}},
 } {
  t.Run(tc.name, func(t *testing.T) {
   if _, err := Load(t.Context(), "test", "config/config.toml", tc.args, io.Discard); err == nil { t.Fatal("invalid configuration accepted") }
  })
 }
 ctx, cancel := context.WithCancel(t.Context()); cancel()
 if _, err := Load(ctx, "test", "config/config.toml", nil, io.Discard); !errors.Is(err, context.Canceled) { t.Fatal(err) }
 if _, err := Load(t.Context(), "test", "config/config.toml", []string{"--config", path, "--help"}, io.Discard); !errors.Is(err, flag.ErrHelp) { t.Fatal(err) }
}
