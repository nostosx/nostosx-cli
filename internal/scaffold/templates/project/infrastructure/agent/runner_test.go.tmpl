package agent

import (
	"context"
	"errors"
	"strings"
	"sync"
	"testing"
	"time"

	"github.com/nostosx/agentx/model"
)

func TestRunnerBoundaries(t *testing.T) {
	entered := make(chan struct{}, 4)
	m := model.Func(func(ctx context.Context, _ *model.Request) (*model.Response, error) {
		entered <- struct{}{}
		<-ctx.Done()
		return nil, ctx.Err()
	})
	runner, err := New(m, "Only use tools explicitly supplied by the application.")
	if err != nil {
		t.Fatal(err)
	}
	for _, prompt := range []string{"", " ", string([]byte{0xff}), strings.Repeat("a", 4097)} {
		if _, err := runner.Ask(t.Context(), prompt); !errors.Is(err, ErrInvalidPrompt) {
			t.Fatalf("invalid prompt accepted: %v", err)
		}
	}
	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
	defer cancel()
	var wg sync.WaitGroup
	failures := make(chan error, 4)
	for range 4 {
		wg.Go(func() { _, err := runner.Ask(ctx, "hello"); failures <- err })
	}
	for range 4 {
		select {
		case <-entered:
		case <-ctx.Done():
			t.Fatal("model did not start")
		}
	}
	if _, err := runner.Ask(t.Context(), "fifth"); !errors.Is(err, ErrBusy) {
		t.Fatal(err)
	}
	cancel()
	wg.Wait()
	close(failures)
	for err := range failures {
		if !errors.Is(err, context.Canceled) {
			t.Fatal(err)
		}
	}
	if _, err := runner.Ask(ctx, "cancelled"); !errors.Is(err, context.Canceled) {
		t.Fatal(err)
	}
	failing, err := New(model.Func(func(context.Context, *model.Request) (*model.Response, error) {
		return nil, errors.New("private provider detail")
	}), "")
	if err != nil {
		t.Fatal(err)
	}
	if _, err := failing.Ask(t.Context(), "hello"); !errors.Is(err, ErrUnavailable) {
		t.Fatal(err)
	}
	if _, err := New(nil, ""); err == nil {
		t.Fatal("nil model accepted")
	}
}

func TestRunnerStartsFreshConversations(t *testing.T) {
	calls := 0
	m := model.Func(func(_ context.Context, request *model.Request) (*model.Response, error) {
		calls++
		if len(request.Messages) != 1 {
			t.Errorf("unexpected retained history: %d messages", len(request.Messages))
		}
		return &model.Response{Message: model.AssistantText("answer")}, nil
	})
	runner, err := New(m, "")
	if err != nil {
		t.Fatal(err)
	}
	for range 2 {
		if answer, err := runner.Ask(t.Context(), "hello"); err != nil || answer != "answer" {
			t.Fatalf("answer=%q err=%v", answer, err)
		}
	}
	if calls != 2 {
		t.Fatalf("model calls=%d", calls)
	}
}
