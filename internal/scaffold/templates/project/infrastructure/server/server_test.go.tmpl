package server

import (
 "context"
 "errors"
 [[if .NeedsToken]]"strings"[[end]]
 "testing"

 "[[.Module]]/infrastructure/config"
)

func testConfig() config.Config {
 return config.Config{[[if .HTTP]]Address: "127.0.0.1:0",[[end]][[if .GRPC]]GRPCAddress: "127.0.0.1:0",[[end]][[if .NeedsToken]]Token: strings.Repeat("a", 32),[[end]]}
}

func TestNewHonorsCancellationAndValidation(t *testing.T) {
 ctx, cancel := context.WithCancel(t.Context()); cancel()
 if _, err := New(ctx, testConfig(), nil, nil); !errors.Is(err, context.Canceled) { t.Fatal(err) }
 if _, err := New(t.Context(), config.Config{}, nil, nil); err == nil { t.Fatal("unsafe configuration accepted") }
 servers, err := New(t.Context(), testConfig(), nil, nil)
 if err != nil { t.Fatal(err) }
 [[if .HTTP]]if servers.HTTP.URL() != nil { t.Fatal("HTTP listener started during construction") }[[end]]
 [[if .GRPC]]if servers.GRPC.URL() != nil { t.Fatal("gRPC listener started during construction") }[[end]]
}
