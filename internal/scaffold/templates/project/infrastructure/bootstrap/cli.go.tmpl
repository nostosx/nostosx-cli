package bootstrap

import (
	"context"
	"errors"
	"flag"
	"io"
	"os"
)

// RunCLI is shared by the monolith host and added service binaries.
func RunCLI(ctx context.Context, name string, args []string, output io.Writer, register Register) error {
	flags := flag.NewFlagSet(name, flag.ContinueOnError)
	flags.SetOutput(output)
	address := flags.String("addr", "127.0.0.1:8080", "loopback HTTP listen address")
	grpcAddress := flags.String("grpc-addr", "127.0.0.1:9090", "loopback gRPC listen address")
	if err := flags.Parse(args); err != nil {
		if errors.Is(err, flag.ErrHelp) {
			return nil
		}
		return err
	}
	if flags.NArg() != 0 {
		return errors.New("unexpected positional arguments")
	}
	application, _, err := New(ctx, Config{Address: *address, GRPCAddress: *grpcAddress, Token: os.Getenv("API_TOKEN")}, register)
	if err != nil {
		return err
	}
	return application.Run(ctx)
}
