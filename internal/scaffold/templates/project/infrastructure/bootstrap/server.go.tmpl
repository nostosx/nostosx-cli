// Package bootstrap owns process configuration and transport lifecycle.
package bootstrap

import (
	"context"
	"errors"
	"strings"
	"time"

	"github.com/nostosx/servex-contrib/transport/grpcx"
	"github.com/nostosx/servex/app"
	"github.com/nostosx/servex/health"
	"github.com/nostosx/servex/transport/httpx"
	"google.golang.org/grpc"

	"[[.Module]]/infrastructure/rpc"
)

// Config contains operator-controlled transport settings.
type Config struct{ Address, GRPCAddress, Token string }

// Register assembles application services before either listener starts.
// Resources opened by a registration belong to the caller and must outlive Run.
type Register func(context.Context, *httpx.Server, grpc.ServiceRegistrar) error

// Servers owns the process listeners.
type Servers struct {
	HTTP *httpx.Server
	GRPC *grpcx.Server
}

// New prepares transports without starting listeners or opening a database.
func New(ctx context.Context, cfg Config, register Register) (*app.App, *Servers, error) {
	if err := ctx.Err(); err != nil {
		return nil, nil, err
	}
	if len(cfg.Token) < 32 || strings.ContainsFunc(cfg.Token, func(r rune) bool { return r < '!' || r > '~' }) {
		return nil, nil, errors.New("API_TOKEN must contain at least 32 printable ASCII characters without whitespace")
	}
	if !rpc.LoopbackAddress(cfg.Address) || !rpc.LoopbackAddress(cfg.GRPCAddress) {
		return nil, nil, errors.New("plaintext HTTP and gRPC listeners must use literal loopback IPs")
	}
	var application *app.App
	check := health.CheckerFunc(func(ctx context.Context) error { return application.Check(ctx) })
	server := httpx.NewServer(httpx.Address(cfg.Address), httpx.Health(check),
		httpx.ReadHeaderTimeout(5*time.Second), httpx.ReadTimeout(10*time.Second),
		httpx.WriteTimeout(10*time.Second), httpx.IdleTimeout(time.Minute), httpx.MaxHeaderBytes(16<<10))
	grpcServer := grpcx.NewServer(grpcx.Address(cfg.GRPCAddress), grpcx.Health(check),
		grpcx.GRPCOptions(grpc.ChainUnaryInterceptor(rpc.Authenticate(cfg.Token)), grpc.ChainStreamInterceptor(rpc.AuthenticateStream(cfg.Token)), grpc.MaxRecvMsgSize(rpc.MaxMessageBytes), grpc.MaxSendMsgSize(rpc.MaxMessageBytes)))
	if register != nil {
		if err := register(ctx, server, grpcServer); err != nil {
			return nil, nil, err
		}
	}
	application = app.New(app.WithHooks(server, grpcServer), app.WithStopTimeout(10*time.Second))
	return application, &Servers{HTTP: server, GRPC: grpcServer}, nil
}
