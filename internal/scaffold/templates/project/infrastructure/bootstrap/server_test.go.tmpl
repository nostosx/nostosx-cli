package bootstrap

import (
	"context"
	"errors"
	"io"
	"strings"
	"testing"

	"github.com/nostosx/servex/transport/httpx"
	"google.golang.org/grpc"
)

func config() Config {
	return Config{Address: "127.0.0.1:0", GRPCAddress: "127.0.0.1:0", Token: strings.Repeat("a", 32)}
}
func TestNewRejectsUnsafeConfiguration(t *testing.T) {
	for _, tc := range []struct {
		name string
		edit func(*Config)
	}{
		{"short token", func(c *Config) { c.Token = "short" }},
		{"whitespace token", func(c *Config) { c.Token = strings.Repeat(" ", 32) }},
		{"public HTTP", func(c *Config) { c.Address = "0.0.0.0:8080" }},
		{"public RPC", func(c *Config) { c.GRPCAddress = ":9090" }},
	} {
		t.Run(tc.name, func(t *testing.T) {
			cfg := config()
			tc.edit(&cfg)
			if _, _, err := New(t.Context(), cfg, nil); err == nil {
				t.Fatal("unsafe settings accepted")
			}
		})
	}
}
func TestNewHonorsCancellationAndRegistrationErrors(t *testing.T) {
	ctx, cancel := context.WithCancel(t.Context())
	cancel()
	if _, _, err := New(ctx, config(), nil); !errors.Is(err, context.Canceled) {
		t.Fatal(err)
	}
	failure := errors.New("registration failed")
	if _, _, err := New(t.Context(), config(), func(context.Context, *httpx.Server, grpc.ServiceRegistrar) error { return failure }); !errors.Is(err, failure) {
		t.Fatal(err)
	}
}
func TestCLIRejectsArgumentsBeforeStartup(t *testing.T) {
	for _, arg := range []string{"--bad", "unexpected"} {
		t.Run(arg, func(t *testing.T) {
			if err := RunCLI(t.Context(), "test", []string{arg}, io.Discard, nil); err == nil {
				t.Fatal("invalid argument accepted")
			}
		})
	}
	if err := RunCLI(t.Context(), "test", []string{"--help"}, io.Discard, nil); err != nil {
		t.Fatal(err)
	}
}
