//go:build integration

package bootstrap

import (
	"context"
	"crypto/rand"
	"fmt"
	"io"
	"net"
	"net/http"
	"os"
	"os/exec"
	"path/filepath"
	"runtime"
	"strings"
	"testing"
	"time"
)

func TestProcessSmoke(t *testing.T) {
	if os.Getenv("NOSTOSX_PROCESS_SMOKE") != "1" {
		t.Skip("run make smoke to exercise application processes")
	}
	if runtime.GOOS == "windows" {
		t.Skip("console interrupt delivery is unavailable; listener lifecycle tests run separately")
	}
	root, err := filepath.Abs("../..")
	if err != nil {
		t.Fatal(err)
	}
	entries, err := filepath.Glob(filepath.Join(root, "services/*/cmd/*/main.go"))
	if err != nil {
		t.Fatal(err)
	}
	if _, err := os.Stat(filepath.Join(root, "cmd/server/main.go")); err == nil {
		entries = append(entries, filepath.Join(root, "cmd/server/main.go"))
	}
	for index, entry := range entries {
		t.Run(fmt.Sprintf("process-%d", index), func(t *testing.T) {
			goTool := os.Getenv("GO")
			if goTool == "" {
				goTool = "go"
			}
			ctx, cancel := context.WithTimeout(t.Context(), 3*time.Minute)
			defer cancel()
			binary := filepath.Join(t.TempDir(), "server")
			build := exec.CommandContext(ctx, goTool, "build", "-mod=readonly", "-o", binary, filepath.Dir(entry))
			build.Dir = root
			if output, err := build.CombinedOutput(); err != nil {
				t.Fatalf("build: %v\n%s", err, output)
			}
			httpAddress, grpcAddress := smokeAddress(t), smokeAddress(t)
			log, err := os.CreateTemp(t.TempDir(), "process-*.log")
			if err != nil {
				t.Fatal(err)
			}
			defer log.Close()
			cmd := exec.CommandContext(ctx, binary, "-addr", httpAddress, "-grpc-addr", grpcAddress)
			cmd.Dir, cmd.Stdout, cmd.Stderr = root, log, log
			for _, item := range os.Environ() {
				if !strings.HasPrefix(item, "API_TOKEN=") && !strings.HasPrefix(item, "AGENT_") && !strings.HasPrefix(item, "ANTHROPIC_") && !strings.HasPrefix(item, "OPENAI_") {
					cmd.Env = append(cmd.Env, item)
				}
			}
			cmd.Env = append(cmd.Env, "API_TOKEN="+rand.Text()+rand.Text())
			if err := cmd.Start(); err != nil {
				t.Fatal(err)
			}
			done := make(chan error, 1)
			go func() { done <- cmd.Wait() }()
			stopped := false
			t.Cleanup(func() {
				if !stopped {
					_ = cmd.Process.Kill()
					select {
					case err := <-done:
						if err != nil {
							t.Logf("terminated during cleanup: %v", err)
						}
					case <-time.After(5 * time.Second):
						t.Error("process cleanup timed out")
					}
				}
				if t.Failed() {
					if output, err := os.ReadFile(log.Name()); err == nil {
						t.Logf("process log:\n%s", output)
					}
				}
			})
			client := &http.Client{Timeout: time.Second}
			probe := func(path string, want int) bool {
				request, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://"+httpAddress+path, nil)
				if err != nil {
					t.Fatal(err)
				}
				response, err := client.Do(request)
				if err != nil {
					return false
				}
				_, readErr := io.Copy(io.Discard, response.Body)
				closeErr := response.Body.Close()
				return readErr == nil && closeErr == nil && response.StatusCode == want
			}
			deadline := time.NewTimer(15 * time.Second)
			defer deadline.Stop()
			ticker := time.NewTicker(25 * time.Millisecond)
			defer ticker.Stop()
			for !probe("/readyz", http.StatusOK) {
				select {
				case err := <-done:
					stopped = true
					t.Fatalf("exited before readiness: %v", err)
				case <-deadline.C:
					t.Fatal("process did not become ready")
				case <-ticker.C:
				}
			}
			if !probe("/livez", http.StatusOK) || !probe("/v1/unconfigured", http.StatusNotFound) {
				t.Fatal("unexpected HTTP routes")
			}
			if err := cmd.Process.Signal(os.Interrupt); err != nil {
				t.Fatal(err)
			}
			select {
			case err := <-done:
				stopped = true
				if err != nil {
					t.Fatalf("shutdown: %v", err)
				}
			case <-time.After(15 * time.Second):
				t.Fatal("graceful shutdown timed out")
			}
		})
	}
}

func smokeAddress(t *testing.T) string {
	t.Helper()
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	address := listener.Addr().String()
	if err := listener.Close(); err != nil {
		t.Fatal(err)
	}
	return address
}
