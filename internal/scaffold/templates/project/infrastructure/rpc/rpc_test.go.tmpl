func TestAuthenticationDeadlineAndRecovery(t *testing.T) {
	t.Parallel()
	interceptor := rpc.Authenticate("token", nil)
	for _, method := range []string{"/example.v1.ExampleService/Execute", "/example.v1.ExampleService/Read"} {
		ctx := metadata.NewIncomingContext(t.Context(), metadata.Pairs("authorization", "Bearer token"))
		ctx, cancel := context.WithTimeout(ctx, time.Second)
		_, err := interceptor(ctx, nil, &grpc.UnaryServerInfo{FullMethod: method}, func(ctx context.Context, _ any) (any, error) {
			deadline, ok := ctx.Deadline()
			if !ok || time.Until(deadline) > time.Second {
				t.Error("caller deadline was extended")
			}
			panic("private credentials")
		})
		cancel()
		if status.Code(err) != codes.Internal || status.Convert(err).Message() != "INTERNAL" {
			t.Fatal(err)
		}
	}
}

func TestSafeErrors(t *testing.T) {
	t.Parallel()
	ctx, cancel := context.WithCancel(t.Context())
	cancel()
	if err := rpc.Error(ctx, errors.New("private database path")); status.Code(err) != codes.Canceled {
		t.Fatal(err)
	}
	if err := rpc.Error(t.Context(), errors.New("private database path")); status.Convert(err).Message() != "INTERNAL" {
		t.Fatal(err)
	}
}


func TestInjectedLogger(t *testing.T) {
 t.Parallel()
 for _, tc := range []struct { name, message string; panic bool }{
  {"panic", "RPC handler panicked", true},
  {"error", "RPC request failed", false},
 } {
  t.Run(tc.name, func(t *testing.T) {
   var output bytes.Buffer
   log, flush, err := logging.New("error", &output, "")
   if err != nil { t.Fatal(err) }
   ctx := metadata.NewIncomingContext(t.Context(), metadata.Pairs("authorization", "Bearer token"))
   _, err = rpc.Authenticate("token", log)(ctx, nil, &grpc.UnaryServerInfo{FullMethod: "/example.Service/Execute"}, func(ctx context.Context, _ any) (any, error) {
    if tc.panic { panic("private credentials") }
    return nil, rpc.Error(ctx, errors.New("private backend"))
   })
   if status.Code(err) != codes.Internal || status.Convert(err).Message() != "INTERNAL" { t.Fatal(err) }
   if err := flush(); err != nil { t.Fatal(err) }
   if !strings.Contains(output.String(), "ERROR") || !strings.Contains(output.String(), tc.message) || strings.Contains(output.String(), "private credentials") { t.Fatal(output.String()) }
  })
 }
}

type testStream struct { grpc.ServerStream; ctx context.Context }
func (s *testStream) Context() context.Context { return s.ctx }

func TestStreamLogger(t *testing.T) {
 t.Parallel()
 var output bytes.Buffer
 log, flush, err := logging.New("error", &output, "")
 if err != nil { t.Fatal(err) }
 ctx := metadata.NewIncomingContext(t.Context(), metadata.Pairs("authorization", "Bearer token"))
 err = rpc.AuthenticateStream("token", log)(nil, &testStream{ctx: ctx}, &grpc.StreamServerInfo{FullMethod: "/example.Service/Watch"}, func(_ any, stream grpc.ServerStream) error {
  return rpc.Error(stream.Context(), errors.New("private backend"))
 })
 if status.Code(err) != codes.Internal || status.Convert(err).Message() != "INTERNAL" { t.Fatal(err) }
 if err := flush(); err != nil { t.Fatal(err) }
 if !strings.Contains(output.String(), "RPC request failed") { t.Fatal(output.String()) }
}

func TestApplicationErrorsKeepCanonicalCodes(t *testing.T) {
 t.Parallel()
 for _,code:=range []errorx.Code{errorx.InvalidArgument,errorx.NotFound,errorx.PermissionDenied,errorx.Unimplemented,errorx.Unavailable} {
  err:=rpc.Error(t.Context(),errorx.New(code,"BUSINESS_REASON","private backend details"))
  if status.Code(err)!=codes.Code(code)||strings.Contains(err.Error(),"private backend") { t.Fatalf("code=%v err=%v",code,err) }
 }
}
